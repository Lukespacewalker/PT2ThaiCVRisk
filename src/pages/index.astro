                    filterSmoke: "Smoking History",
                    smokeYes: "Smoker",
                    smokeNo: "Non-smoker",
                    filterAlc: "Alcohol History",
                    alcYes: "Alcohol Drinker",
                    alcNo: "Non-drinker",
                    filterAge: "Age Range",
                    all: "All",
                    filterRisk: "Risk Category",
                    riskLow: "Low (<10%)",
                    riskInt: "Intermediate (10-19.9%)",
                    riskHigh: "High (≥20%)",
                    filterBP: "Blood Pressure Stage",
                    bpNormal: "Normal BP",
                    bpPre: "Prehypertension",
                    bpStage1: "Stage 1 HTN",
                    bpStage2: "Stage 2 HTN",
                    kpiTotalTitle: "Total Assessed",
                    kpiTotalLabel: "Security Guards (100% Male)",
                    kpiTotalNote: "2026 Complete Health Checkup & Lifestyle Data",
                    kpiMedianTitle: "Median Thai CV Risk",
                    kpiMedianLabel: "10-Year CVD Event Probability",
                    kpiMedianNote: "Clinical standard: Low (<10%), Intermediate (10-19%), High (≥20%)",
                    kpiHighTitle: "Intermediate & High Risk Ratio",
                    kpiHighNote: "Personnel requiring active clinical intervention",
                    kpiSmokeTitle: "Smoking Prevalence",
                    kpiSmokeNote: "Adds +0.42 to FullScore equation",
                    kpiAlcTitle: "Alcohol Prevalence",
                    kpiAlcNote: "Risk factor for hepatic health, HTN, and hypertriglyceridemia",
                    kpiHTNTitle: "Hypertension (HTN)",
                    kpiHTNNote: "High weight predictor in Thai CV Risk model",
                    kpiDMTitle: "Diabetes & Prediabetes",
                    kpiDMNote: "Diabetes contributes +0.70 to risk score",
                    chartDistTitle: "Risk Stratification Distribution",
                    chartScatterTitle: "Correlation: Age, Systolic BP, and Thai CV Risk",
                    chartBoxTitle: "Thai CV Risk Distribution by Age Group",
                    chartFactorsTitle: "Prevalence of Clinical Risk Factors & Lifestyle",
                    tableTitle: "Individual Health Profiles (Public Edition - Anonymized)",
                    searchPlaceholder: "Search ID, Code, Post...",
                    methodologyTitle: "Methodology & Thai CV Risk Score Equation",
                    equationTitle: "Score Equation (Total Cholesterol model)",
                    riskThresholdsTitle: "10-Year Risk Stratification Criteria",
                    caveatTitle: "Lifestyle & Smoking Data Integration:",
                    caveatText: "Directly integrated with the official 2026 lifestyle survey (69 of 74 guards matched, 93.2% match rate). Unmatched records remain unknown and are excluded from prevalence and actual-risk calculations.",
                    personUnit: "guards",
                    lowRiskLabel: "Low Risk (<10%)",
                    intRiskLabel: "Intermediate Risk (10-19.9%)",
                    highRiskLabel: "High Risk (20-29.9%)",
                    veryHighRiskLabel: "Very High Risk (≥30%)",
                    unknownRiskLabel: "Actual score unavailable",
                    extrapolatedLabel: "Extrapolated",
                    respondentsUnit: "with survey data"
                }
            };

            // Dashboard State
            let currentLang = "th";
            let selectedAge = "ALL";
            let selectedRisk = "ALL";
            let selectedBP = "ALL";
            let selectedSmoke = "ALL";
            let selectedAlc = "ALL";
            let searchQuery = "";
            let sortColumn = "id";
            let sortAsc = true;

            function filterData() {
                return window.DASHBOARD_DATA.filter(row => {
                    const effRisk = row.thai_cv_risk;

                    // Age Filter
                    if (selectedAge !== "ALL" && row.age_group !== selectedAge) return false;

                    // Risk Filter
                    if (selectedRisk !== "ALL") {
                        if (effRisk === null) return false;
                        if (selectedRisk === "Low Risk (<10%)" && effRisk >= 10.0) return false;
                        if (selectedRisk === "Intermediate Risk (10-19.9%)" && (effRisk < 10.0 || effRisk >= 20.0)) return false;
                        if (selectedRisk === "High Risk (20-29.9%)" && effRisk < 20.0) return false;
                    }

                    // BP Filter
                    if (selectedBP !== "ALL" && row.bp_stage !== selectedBP) return false;

                    // Smoking Filter
                    if (selectedSmoke !== "ALL" && String(row.smoking_actual) !== selectedSmoke) return false;

                    // Alcohol Filter
                    if (selectedAlc !== "ALL" && String(row.alcohol_actual) !== selectedAlc) return false;

                    // Search Query
                    if (searchQuery) {
                        const q = searchQuery.toLowerCase();
                        const matchName = (row.name || "").toLowerCase().includes(q);
                        const matchPost = (row.work_post || "").toLowerCase().includes(q);
                        const matchId = String(row.id).includes(q);
                        if (!matchName && !matchPost && !matchId) return false;
                    }

                    return true;
                });
            }

            function updateKPIs(filtered) {
                const total = filtered.length;
                document.getElementById("kpi-total").innerText = total;

                if (total === 0) {
                    document.getElementById("kpi-median").innerText = "0.0%";
                    document.getElementById("kpi-high-prop").innerText = "0.0%";
                    document.getElementById("kpi-high-count-label").innerText = "0 / 0";
                    document.getElementById("kpi-smoke-prop").innerText = "0.0%";
                    document.getElementById("kpi-smoke-count-label").innerText = "0 คน";
                    document.getElementById("kpi-alc-prop").innerText = "0.0%";
                    document.getElementById("kpi-alc-count-label").innerText = "0 คน";
                    document.getElementById("kpi-htn-prop").innerText = "0.0%";
                    document.getElementById("kpi-htn-count-label").innerText = "0 / 0";
                    document.getElementById("kpi-dm-prop").innerText = "0.0%";
                    document.getElementById("kpi-dm-count-label").innerText = "0 / 0";
                    return;
                }

                const risks = filtered.map(r => r.thai_cv_risk).filter(v => v !== null).sort((a, b) => a - b);
                const median = risks.length === 0
                    ? "-"
                    : risks.length % 2 === 0
                    ? ((risks[risks.length / 2 - 1] + risks[risks.length / 2]) / 2).toFixed(2)
                    : risks[Math.floor(risks.length / 2)].toFixed(2);
                document.getElementById("kpi-median").innerText = median === "-" ? median : `${median}%`;

                // Intermediate & High Risk (>=10%)
                const scoredTotal = risks.length;
                const highRiskCount = risks.filter(risk => risk >= 10.0).length;
                const highRiskProp = scoredTotal > 0 ? ((highRiskCount / scoredTotal) * 100).toFixed(1) : "0.0";
                document.getElementById("kpi-high-prop").innerText = `${highRiskProp}%`;
                document.getElementById("kpi-high-count-label").innerText = `${highRiskCount} / ${scoredTotal} ${I18N[currentLang].personUnit}`;

                // Smoking Prevalence
                const knownSmoke = filtered.filter(r => r.smoking_actual === 0 || r.smoking_actual === 1);
                const smokeCount = filtered.filter(r => r.smoking_actual === 1).length;
                const smokeProp = knownSmoke.length > 0 ? ((smokeCount / knownSmoke.length) * 100).toFixed(1) : "0.0";
                document.getElementById("kpi-smoke-prop").innerText = `${smokeProp}%`;
                document.getElementById("kpi-smoke-count-label").innerText = `${smokeCount} / ${knownSmoke.length} ${I18N[currentLang].respondentsUnit}`;

                // Alcohol Prevalence
                const knownAlcohol = filtered.filter(r => r.alcohol_actual === 0 || r.alcohol_actual === 1);
                const alcCount = filtered.filter(r => r.alcohol_actual === 1).length;
                const alcProp = knownAlcohol.length > 0 ? ((alcCount / knownAlcohol.length) * 100).toFixed(1) : "0.0";
                document.getElementById("kpi-alc-prop").innerText = `${alcProp}%`;
                document.getElementById("kpi-alc-count-label").innerText = `${alcCount} / ${knownAlcohol.length} ${I18N[currentLang].respondentsUnit}`;

                // Hypertension (SBP >= 140 or DBP >= 90)
                const htnCount = filtered.filter(r => (r.sbp >= 140 || r.dbp >= 90)).length;
                const htnProp = ((htnCount / total) * 100).toFixed(1);
                document.getElementById("kpi-htn-prop").innerText = `${htnProp}%`;
                document.getElementById("kpi-htn-count-label").innerText = `${htnCount} / ${total} ${I18N[currentLang].personUnit} (Stage 1 & 2)`;

                // DM & Pre-DM (FBS >= 100)
                const dmCount = filtered.filter(r => r.fbs >= 100).length;
                const dmProp = ((dmCount / total) * 100).toFixed(1);
                const actualDmCount = filtered.filter(r => r.fbs >= 126).length;
                document.getElementById("kpi-dm-prop").innerText = `${dmProp}%`;
                document.getElementById("kpi-dm-count-label").innerText = `เบาหวาน ${actualDmCount} คน, เสี่ยง ${dmCount - actualDmCount} คน`;
            }

            function renderCharts(filtered) {
                const scored = filtered.filter(r => r.thai_cv_risk !== null);
                const total = scored.length;

                // 1. Risk Stratification Bar
                const catCounts = {
                    "Low Risk (<10%)": 0,
                    "Intermediate Risk (10-19.9%)": 0,
                    "High Risk (20-29.9%)": 0,
                    "Very High Risk (>=30%)": 0
                };
                scored.forEach(r => {
                    const cat = r.risk_category;
                    if (catCounts[cat] !== undefined) catCounts[cat]++;
                });

                const catLabels = [
                    I18N[currentLang].lowRiskLabel,
                    I18N[currentLang].intRiskLabel,
                    I18N[currentLang].highRiskLabel,
                    I18N[currentLang].veryHighRiskLabel
                ];
                const catValues = [
                    catCounts["Low Risk (<10%)"],
                    catCounts["Intermediate Risk (10-19.9%)"],
                    catCounts["High Risk (20-29.9%)"],
                    catCounts["Very High Risk (>=30%)"]
                ];
                const catColors = ["#2E7D32", "#E6A23C", "#E65100", "#C62828"];

                const distData = [{
                    x: catLabels,
                    y: catValues,
                    type: 'bar',
                    marker: { color: catColors, line: { color: '#2A2A2A', width: 2 } },
                    text: catValues.map(v => total > 0 ? `${v} (${((v/total)*100).toFixed(1)}%)` : "0"),
                    textposition: 'auto',
                    hoverinfo: 'x+y'
                }];

                const distLayout = {
                    font: { family: 'Outfit, Inter, sans-serif' },
                    paper_bgcolor: 'transparent',
                    plot_bgcolor: 'transparent',
                    margin: { t: 30, r: 20, l: 40, b: 60 },
                    yaxis: { title: currentLang === 'th' ? 'จำนวน (คน)' : 'Count', gridcolor: '#e0ded8' },
                    xaxis: { tickangle: -10 }
                };
                Plotly.react('riskDistChart', distData, distLayout, { responsive: true, displayModeBar: false });

                // 2. Scatter: Age vs SBP colored by Risk Score
                const scatterData = [{
                    x: scored.map(r => r.age),
                    y: scored.map(r => r.sbp),
                    text: scored.map(r => `${r.name}<br>อายุ: ${r.age} ปี<br>จุด: ${r.work_post || '-'}<br>บุหรี่: ${r.smoking_status}<br>SBP: ${r.sbp} mmHg<br>Risk: ${r.thai_cv_risk}%${r.risk_is_extrapolated ? '<br>Extrapolated' : ''}`),
                    mode: 'markers',
                    type: 'scatter',
                    marker: {
                        size: scored.map(r => Math.max(10, Math.min(26, r.thai_cv_risk * 1.2))),
                        color: scored.map(r => r.thai_cv_risk),
                        colorscale: [
                            [0.0, '#2E7D32'],
                            [0.2, '#8BC34A'],
                            [0.4, '#FFEB3B'],
                            [0.6, '#FF9800'],
                            [0.8, '#F44336'],
                            [1.0, '#B71C1C']
                        ],
                        colorbar: {
                            title: 'Risk %',
                            thickness: 14,
                            len: 0.8
                        },
                        line: { color: '#2A2A2A', width: 1.5 }
                    },
                    hoverinfo: 'text'
                }];

                const scatterLayout = {
                    font: { family: 'Outfit, Inter, sans-serif' },
                    paper_bgcolor: 'transparent',
                    plot_bgcolor: 'transparent',
                    margin: { t: 30, r: 40, l: 50, b: 50 },
                    xaxis: { title: currentLang === 'th' ? 'อายุ (ปี)' : 'Age (Years)', gridcolor: '#e0ded8' },
                    yaxis: { title: currentLang === 'th' ? 'ความดันโลหิตตัวบน SBP (mmHg)' : 'Systolic BP (mmHg)', gridcolor: '#e0ded8' }
                };
                Plotly.react('scatterChart', scatterData, scatterLayout, { responsive: true, displayModeBar: false });

                // 3. Box Plot by Age Group
                const ageGroups = ["<40", "40-49", "50-59"];
                const boxTraces = ageGroups.map((ag, i) => {
                    const subset = scored.filter(r => r.age_group === ag);
                    return {
                        y: subset.map(r => r.thai_cv_risk),
                        name: ag + (currentLang === 'th' ? ' ปี' : ' yrs'),
                        type: 'box',
                        boxpoints: 'all',
                        jitter: 0.3,
                        pointpos: -1.8,
                        marker: { color: ['#2B5953', '#C85A17', '#E3B448'][i % 3], size: 6 }
                    };
                });

                const boxLayout = {
                    font: { family: 'Outfit, Inter, sans-serif' },
                    paper_bgcolor: 'transparent',
                    plot_bgcolor: 'transparent',
                    margin: { t: 30, r: 20, l: 40, b: 40 },
                    yaxis: { title: 'Thai CV Risk (%)', gridcolor: '#e0ded8' },
                    showlegend: false
                };
                Plotly.react('boxPlotChart', boxTraces, boxLayout, { responsive: true, displayModeBar: false });

                // 4. Clinical & Lifestyle Factors Horizontal Bar
                const factors = [
                    { label: currentLang === 'th' ? 'โคเลสเตอรอลสูง (≥200)' : 'High Chol (≥200)', count: filtered.filter(r => r.cholesterol >= 200).length },
                    { label: currentLang === 'th' ? 'ความดันสูง (≥140/90)' : 'HTN (≥140/90)', count: filtered.filter(r => r.sbp >= 140 || r.dbp >= 90).length },
                    { label: currentLang === 'th' ? 'ดื่มแอลกอฮอล์' : 'Drink Alcohol', count: filtered.filter(r => r.alcohol_actual === 1).length },
                    { label: currentLang === 'th' ? 'สูบบุหรี่' : 'Smoke Cigarette', count: filtered.filter(r => r.smoking_actual === 1).length },
                    { label: currentLang === 'th' ? 'ไตรกลีเซอไรด์สูง (≥150)' : 'High TG (≥150)', count: filtered.filter(r => r.triglyceride >= 150).length },
                    { label: currentLang === 'th' ? 'น้ำตาลสูง (FBS ≥100)' : 'High FBS (≥100)', count: filtered.filter(r => r.fbs >= 100).length },
                    { label: currentLang === 'th' ? 'ดัชนีมวลกายเกิน (BMI ≥25)' : 'Obese (BMI ≥25)', count: filtered.filter(r => r.bmi >= 25).length },
                    { label: currentLang === 'th' ? 'ไขมันดีต่ำ (HDL <40)' : 'Low HDL (<40)', count: filtered.filter(r => r.hdl < 40).length }
                ].sort((a, b) => a.count - b.count);

                const factorsData = [{
                    x: factors.map(f => factors.length > 0 && total > 0 ? ((f.count / total) * 100) : 0),
                    y: factors.map(f => f.label),
                    type: 'bar',
                    orientation: 'h',
                    marker: { color: '#C85A17', line: { color: '#2A2A2A', width: 1.5 } },
                    text: factors.map(f => total > 0 ? `${f.count} คน (${((f.count / total) * 100).toFixed(0)}%)` : "0"),
                    textposition: 'auto',
                    hoverinfo: 'x+y'
                }];

                const factorsLayout = {
                    font: { family: 'Outfit, Inter, sans-serif' },
                    paper_bgcolor: 'transparent',
                    plot_bgcolor: 'transparent',
                    margin: { t: 30, r: 20, l: 160, b: 40 },
                    xaxis: { title: '%', range: [0, 100], gridcolor: '#e0ded8' }
                };
                Plotly.react('factorsBarChart', factorsData, factorsLayout, { responsive: true, displayModeBar: false });
            }

            function renderTable(filtered) {
                const tbody = document.getElementById("table-body");
                if (!tbody) return;

                // Sort
                const sorted = [...filtered].sort((a, b) => {
                    let valA, valB;
                    if (sortColumn === "thai_cv_risk" || sortColumn === "risk_category") {
                        valA = a.thai_cv_risk;
                        valB = b.thai_cv_risk;
                    } else {
                        valA = a[sortColumn];
                        valB = b[sortColumn];
                    }

                    if (valA === null || valA === undefined) return 1;
                    if (valB === null || valB === undefined) return -1;
                    if (valA < valB) return sortAsc ? -1 : 1;
                    if (valA > valB) return sortAsc ? 1 : -1;
                    return 0;
                });

                tbody.innerHTML = sorted.map(row => {
                    const risk = row.thai_cv_risk;
                    let badgeClass = "badge-low";
                    let catLabel = I18N[currentLang].lowRiskLabel;

                    if (risk === null) {
                        badgeClass = "badge-nodrink";
                        catLabel = I18N[currentLang].unknownRiskLabel;
                    } else if (risk >= 30.0) {
                        badgeClass = "badge-veryhigh";
                        catLabel = I18N[currentLang].veryHighRiskLabel;
                    } else if (risk >= 20.0) {
                        badgeClass = "badge-high";
                        catLabel = I18N[currentLang].highRiskLabel;
                    } else if (risk >= 10.0) {
                        badgeClass = "badge-intermediate";
                        catLabel = I18N[currentLang].intRiskLabel;
                    }

                    const smokeBadge = row.smoking_actual === 1 
                        ? '<span class="badge badge-smoke">สูบบุหรี่</span>' 
                        : (row.smoking_actual === 0 ? '<span class="badge badge-nosmoke">ไม่สูบ</span>' : '<span class="badge badge-nodrink">ไม่พบข้อมูล</span>');

                    const alcBadge = row.alcohol_actual === 1 
                        ? '<span class="badge badge-drink">ดื่มแอลกอฮอล์</span>' 
                        : (row.alcohol_actual === 0 ? '<span class="badge badge-nodrink">ไม่ดื่ม</span>' : '<span class="badge badge-nodrink">ไม่พบข้อมูล</span>');

                    const extrapolatedBadge = row.risk_is_extrapolated
                        ? `<span class="badge badge-extrapolated" title="${row.risk_extrapolation_reasons.join(', ')}">${I18N[currentLang].extrapolatedLabel}</span>`
                        : "";

                    let quitDiffHtml = "-";
                    if (row.smoking_actual === 1 && row.thai_cv_risk_baseline !== null) {
                        const diff = (row.thai_cv_risk - row.thai_cv_risk_baseline).toFixed(2);
                        quitDiffHtml = `<span style="color:#00695C; font-weight:bold;">${row.thai_cv_risk_baseline}%</span> <span style="font-size:0.75rem; color:#D84315;">(-${diff}%)</span>`;
                    } else if (row.smoking_actual === 0) {
                        quitDiffHtml = `<span style="color:#888; font-size:0.8rem;">ไม่สูบ</span>`;
                    }

                    return `
                        <tr>
                            <td><strong>${row.id}</strong></td>
                            <td><span class="badge badge-bv">${row.work_post || '-'}</span></td>
                            <td><strong>${row.name}</strong></td>
                            <td>${row.age}</td>
                            <td>${smokeBadge}</td>
                            <td>${alcBadge}</td>
                            <td>${row.sbp} / ${row.dbp} <span style="font-size:0.78rem; color:#666;">(${row.bp_stage})</span></td>
                            <td>${row.bmi ? row.bmi.toFixed(1) : '-'}</td>
                            <td>${row.fbs} ${row.fbs >= 126 ? '<span style="color:#B71C1C; font-weight:bold;">(DM)</span>' : ''}</td>
                            <td>${row.cholesterol}</td>
                            <td><strong style="font-size:1.1rem; color:var(--accent);">${risk !== null ? risk.toFixed(2) + '%' : `${row.thai_cv_risk_baseline.toFixed(2)}–${row.thai_cv_risk_if_smoke.toFixed(2)}%`}</strong></td>
                            <td><span class="badge ${badgeClass}">${catLabel}</span> ${extrapolatedBadge}</td>
                            <td>${quitDiffHtml}</td>
                        </tr>
                    `;
                }).join("");
            }

            function refreshDashboard() {
                const filtered = filterData();
                updateKPIs(filtered);
                renderCharts(filtered);
                renderTable(filtered);
            }

            function setLanguage(lang) {
                currentLang = lang;
                document.documentElement.lang = lang;
                document.documentElement.setAttribute('data-lang', lang);

                // Language Buttons
                document.querySelectorAll(".language-button").forEach(btn => {
                    btn.classList.toggle("active", btn.getAttribute("data-language") === lang);
                });

                // Translate static strings
                document.querySelectorAll("[data-i18n]").forEach(el => {
                    const key = el.getAttribute("data-i18n");
                    if (I18N[lang][key]) el.innerText = I18N[lang][key];
                });

                // Search placeholder
                const searchEl = document.getElementById("search-input");
                if (searchEl) searchEl.placeholder = I18N[lang].searchPlaceholder;

                refreshDashboard();
            }

            // Event Listeners Setup
            document.addEventListener("DOMContentLoaded", () => {
                // Language buttons
                document.querySelectorAll(".language-button").forEach(btn => {
                    btn.addEventListener("click", () => setLanguage(btn.getAttribute("data-language")));
                });

                // Smoke Tabs
                document.querySelectorAll("#smoke-tabs .pill").forEach(pill => {
                    pill.addEventListener("click", () => {
                        document.querySelectorAll("#smoke-tabs .pill").forEach(p => p.classList.remove("active"));
                        pill.classList.add("active");
                        selectedSmoke = pill.getAttribute("data-smoke");
                        refreshDashboard();
                    });
                });

                // Alcohol Tabs
                document.querySelectorAll("#alc-tabs .pill").forEach(pill => {
                    pill.addEventListener("click", () => {
                        document.querySelectorAll("#alc-tabs .pill").forEach(p => p.classList.remove("active"));
                        pill.classList.add("active");
                        selectedAlc = pill.getAttribute("data-alc");
                        refreshDashboard();
                    });
                });

                // Age Tabs
                document.querySelectorAll("#age-tabs .pill").forEach(pill => {
                    pill.addEventListener("click", () => {
                        document.querySelectorAll("#age-tabs .pill").forEach(p => p.classList.remove("active"));
                        pill.classList.add("active");
                        selectedAge = pill.getAttribute("data-age");
                        refreshDashboard();
                    });
                });

                // Risk Tabs
                document.querySelectorAll("#risk-tabs .pill").forEach(pill => {
                    pill.addEventListener("click", () => {
                        document.querySelectorAll("#risk-tabs .pill").forEach(p => p.classList.remove("active"));
                        pill.classList.add("active");
                        selectedRisk = pill.getAttribute("data-risk");
                        refreshDashboard();
                    });
                });

                // BP Tabs
                document.querySelectorAll("#bp-tabs .pill").forEach(pill => {
                    pill.addEventListener("click", () => {
                        document.querySelectorAll("#bp-tabs .pill").forEach(p => p.classList.remove("active"));
                        pill.classList.add("active");
                        selectedBP = pill.getAttribute("data-bp");
                        refreshDashboard();
                    });
                });

                // Search Input
                const searchEl = document.getElementById("search-input");
                if (searchEl) {
                    searchEl.addEventListener("input", e => {
                        searchQuery = e.target.value.trim();
                        refreshDashboard();
                    });
                }

                // Table Sorting Headers
                document.querySelectorAll(".data-table th[data-sort]").forEach(th => {
                    th.addEventListener("click", () => {
                        const col = th.getAttribute("data-sort");
                        if (sortColumn === col) {
                            sortAsc = !sortAsc;
                        } else {
                            sortColumn = col;
                            sortAsc = true;
                        }
                        renderTable(filterData());
                    });
                });

                // Initial render
                refreshDashboard();
            });
        </script>
    </body>
</html>
