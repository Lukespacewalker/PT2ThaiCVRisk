---
import "../styles/global.css";
import guardsData from "../data/thai_cv_data.json";

// Initial SSR stats
const totalCount = guardsData.length;
const meanRisk = (guardsData.reduce((acc, d) => acc + (d.thai_cv_risk || 0), 0) / totalCount).toFixed(2);
---

<html lang="th" data-lang="th">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>Thai CV Risk Score Dashboard - กองรักษาความปลอดภัย 2569</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Outfit:wght@500;700;800&display=swap"
            rel="stylesheet"
        />
        <!-- Plotly via CDN for robust responsive charting -->
        <script is:inline src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
    </head>
    <body>
        <div class="container">
            <!-- Header -->
            <header class="header">
                <div class="header-controls">
                    <a href="/calculator" class="nav-button" id="nav-calc-btn">
                        <span data-i18n="goToCalculator">ประเมินความเสี่ยงด้วยตนเอง →</span>
                    </a>
                    <div class="language-switcher" aria-label="Language selector">
                        <button class="language-button active" type="button" data-language="th">ไทย</button>
                        <button class="language-button" type="button" data-language="en">EN</button>
                    </div>
                </div>
                <h1 data-i18n="pageTitle">
                    แดชบอร์ดความเสี่ยงโรคหัวใจและหลอดเลือด (Thai CV Risk Score)
                </h1>
                <p class="header-subtitle" data-i18n="pageSubtitle">
                    ระบบประเมินความเสี่ยงโรคหัวใจและหลอดเลือดในระยะเวลา 10 ปี (Thai CV Risk Score: Ramathibodi / EGAT) ของเจ้าหน้าที่รักษาความปลอดภัย ประจำปี 2569
                </p>
            </header>

            <!-- Filters Section -->
            <div class="filter-section">
                <div class="filter-row">
                    <!-- Mode Filter -->
                    <div class="filter-group">
                        <div class="filter-title" data-i18n="filterMode">
                            โหมดข้อมูลการสูบบุหรี่
                        </div>
                        <div class="pill-list" id="mode-tabs">
                            <div class="pill active" data-mode="baseline" data-i18n="modeBaseline">
                                ข้อมูลพื้นฐาน (ไม่สูบทุกคน)
                            </div>
                            <div class="pill" data-mode="simulated" data-i18n="modeSimulated">
                                จำลองประชากร (ชายไทย ~35%)
                            </div>
                            <div class="pill" data-mode="smoke_all" data-i18n="modeSmokeAll">
                                สมมติว่าสูบทุกคน (What-if)
                            </div>
                        </div>
                    </div>

                    <!-- Age Filter -->
                    <div class="filter-group">
                        <div class="filter-title" data-i18n="filterAge">
                            ช่วงอายุ
                        </div>
                        <div class="pill-list" id="age-tabs">
                            <div class="pill active" data-age="ALL" data-i18n="all">ทั้งหมด</div>
                            <div class="pill" data-age="<40">&lt; 40 ปี</div>
                            <div class="pill" data-age="40-49">40 - 49 ปี</div>
                            <div class="pill" data-age="50-59">50 - 59 ปี</div>
                        </div>
                    </div>

                    <!-- Risk Category Filter -->
                    <div class="filter-group">
                        <div class="filter-title" data-i18n="filterRisk">
                            ระดับความเสี่ยง
                        </div>
                        <div class="pill-list" id="risk-tabs">
                            <div class="pill active" data-risk="ALL" data-i18n="all">ทั้งหมด</div>
                            <div class="pill" data-risk="Low Risk (<10%)" data-i18n="riskLow">เสี่ยงต่ำ (&lt;10%)</div>
                            <div class="pill" data-risk="Intermediate Risk (10-19.9%)" data-i18n="riskInt">เสี่ยงปานกลาง (10-19.9%)</div>
                            <div class="pill" data-risk="High Risk (20-29.9%)" data-i18n="riskHigh">เสี่ยงสูง (&ge;20%)</div>
                        </div>
                    </div>

                    <!-- BP Filter -->
                    <div class="filter-group">
                        <div class="filter-title" data-i18n="filterBP">
                            ระดับความดันโลหิต
                        </div>
                        <div class="pill-list" id="bp-tabs">
                            <div class="pill active" data-bp="ALL" data-i18n="all">ทั้งหมด</div>
                            <div class="pill" data-bp="Normal BP" data-i18n="bpNormal">ความดันปกติ</div>
                            <div class="pill" data-bp="Prehypertension" data-i18n="bpPre">เสี่ยงสูง (Pre-HTN)</div>
                            <div class="pill" data-bp="Stage 1 HTN" data-i18n="bpStage1">ความดันสูง ระดับ 1</div>
                            <div class="pill" data-bp="Stage 2 HTN" data-i18n="bpStage2">ความดันสูง ระดับ 2</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPIs Section -->
            <div class="grid">
                <!-- Total Assessed -->
                <div class="card">
                    <div class="card-title" data-i18n="kpiTotalTitle">
                        จำนวนเจ้าหน้าที่ที่ประเมิน
                    </div>
                    <div class="kpi-value" id="kpi-total">{totalCount}</div>
                    <div class="kpi-label" data-i18n="kpiTotalLabel">
                        เจ้าหน้าที่รักษาความปลอดภัย (เพศชาย 100%)
                    </div>
                    <div class="threshold-note" data-i18n="kpiTotalNote">
                        ข้อมูลตรวจสุขภาพประจำปี 2569 ครบถ้วน 100%
                    </div>
                </div>

                <!-- Median Thai CV Risk -->
                <div class="card">
                    <div class="card-title" data-i18n="kpiMedianTitle">
                        มัธยฐานความเสี่ยง (Thai CV Risk)
                    </div>
                    <div class="kpi-value" id="kpi-median">0.0%</div>
                    <div class="kpi-label" data-i18n="kpiMedianLabel">
                        โอกาสเกิดโรคหัวใจและหลอดเลือดใน 10 ปี
                    </div>
                    <div class="threshold-note" data-i18n="kpiMedianNote">
                        เกณฑ์มาตรฐาน: ต่ำ (&lt;10%), ปานกลาง (10-19%), สูง (&ge;20%)
                    </div>
                </div>

                <!-- High & Intermediate Risk Proportion -->
                <div class="card">
                    <div class="card-title" data-i18n="kpiHighTitle">
                        สัดส่วนกลุ่มเสี่ยงปานกลาง-สูง
                    </div>
                    <div class="kpi-value" id="kpi-high-prop">0.0%</div>
                    <div class="kpi-label" id="kpi-high-count-label">
                        0 จาก 0 คน
                    </div>
                    <div class="threshold-note" data-i18n="kpiHighNote">
                        กลุ่มที่ควรได้รับการติดตามและปรับพฤติกรรมเร่งด่วน
                    </div>
                </div>

                <!-- Hypertension Prevalence -->
                <div class="card">
                    <div class="card-title" data-i18n="kpiHTNTitle">
                        ความดันโลหิตสูง (HTN)
                    </div>
                    <div class="kpi-value" id="kpi-htn-prop">0.0%</div>
                    <div class="kpi-label" id="kpi-htn-count-label">
                        SBP &ge; 140 หรือ DBP &ge; 90 mmHg
                    </div>
                    <div class="threshold-note" data-i18n="kpiHTNNote">
                        ปัจจัยหลักที่มีน้ำหนักสูงในสมการ Thai CV Risk
                    </div>
                </div>

                <!-- Diabetes Prevalence -->
                <div class="card">
                    <div class="card-title" data-i18n="kpiDMTitle">
                        เบาหวานและเสี่ยงเบาหวาน
                    </div>
                    <div class="kpi-value" id="kpi-dm-prop">0.0%</div>
                    <div class="kpi-label" id="kpi-dm-count-label">
                        FBS &ge; 100 mg/dL (เบาหวาน &ge; 126)
                    </div>
                    <div class="threshold-note" data-i18n="kpiDMNote">
                        ภาวะเบาหวานเพิ่มแต้มความเสี่ยงในสมการ +0.70
                    </div>
                </div>
            </div>

            <!-- Charts Row 1: Distribution & Scatter -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(480px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                <div class="card" style="margin-bottom: 0;">
                    <div class="card-title" data-i18n="chartDistTitle">
                        สัดส่วนระดับความเสี่ยง (Thai CV Risk Stratification)
                    </div>
                    <div class="chart-container" id="riskDistChart" style="height: 420px;"></div>
                </div>

                <div class="card" style="margin-bottom: 0;">
                    <div class="card-title" data-i18n="chartScatterTitle">
                        ความสัมพันธ์ระหว่างอายุ ความดันโลหิต และคะแนนความเสี่ยง
                    </div>
                    <div class="chart-container" id="scatterChart" style="height: 420px;"></div>
                </div>
            </div>

            <!-- Charts Row 2: Box Plot & Clinical Factors -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(480px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                <div class="card" style="margin-bottom: 0;">
                    <div class="card-title" data-i18n="chartBoxTitle">
                        การกระจายตัวของค่าความเสี่ยงจำแนกตามช่วงอายุ
                    </div>
                    <div class="chart-container" id="boxPlotChart" style="height: 420px;"></div>
                </div>

                <div class="card" style="margin-bottom: 0;">
                    <div class="card-title" data-i18n="chartFactorsTitle">
                        สัดส่วนปัจจัยเสี่ยงและโรคร่วมสำคัญ
                    </div>
                    <div class="chart-container" id="factorsBarChart" style="height: 420px;"></div>
                </div>
            </div>

            <!-- Detailed Table Section -->
            <div class="card">
                <div class="card-title">
                    <span data-i18n="tableTitle">รายชื่อและผลการประเมินรายบุคคล</span>
                    <input
                        type="text"
                        id="search-input"
                        class="search-input"
                        placeholder="ค้นหาชื่อหรือลำดับ..."
                        data-i18n-placeholder="searchPlaceholder"
                    />
                </div>
                <div class="table-wrap">
                    <table class="data-table" id="guards-table">
                        <thead>
                            <tr>
                                <th data-sort="id">ลำดับ ⇅</th>
                                <th data-sort="name">ชื่อ-สกุล ⇅</th>
                                <th data-sort="age">อายุ ⇅</th>
                                <th data-sort="sbp">ความดัน (SBP/DBP) ⇅</th>
                                <th data-sort="bmi">BMI ⇅</th>
                                <th data-sort="fbs">น้ำตาล FBS ⇅</th>
                                <th data-sort="cholesterol">โคเลสเตอรอลรวม ⇅</th>
                                <th data-sort="hdl">HDL-C ⇅</th>
                                <th data-sort="ldl">LDL-C ⇅</th>
                                <th data-sort="thai_cv_risk">Thai CV Risk (%) ⇅</th>
                                <th data-sort="risk_category">ระดับความเสี่ยง ⇅</th>
                            </tr>
                        </thead>
                        <tbody id="table-body">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Clinical Methodology & Reference Section -->
            <div class="card methodology-card">
                <div class="card-title" data-i18n="methodologyTitle">
                    ระเบียบวิธีวิจัยและสูตรการประเมิน Thai CV Risk Score
                </div>
                <div class="methodology-grid">
                    <div>
                        <h4 data-i18n="equationTitle">สูตรการคำนวณ (กรณีมีผลโคเลสเตอรอลรวม)</h4>
                        <p style="font-family: monospace; font-size: 0.9rem; background: #eef2f1; padding: 0.8rem; border-radius: 4px; border: 1px solid var(--accent-light);">
                            <strong>FullScore</strong> = (0.08183 &times; Age) + (0.39499 &times; Sex) + (0.02084 &times; SBP) + (0.69974 &times; DM) + (0.00212 &times; CHOL) + (0.41916 &times; Smoking)<br/><br/>
                            <strong>Risk (%)</strong> = [1 - 0.978296<sup>exp(FullScore - 7.04423)</sup>] &times; 100
                        </p>
                        <p style="font-size: 0.88rem; color: #555;">
                            พัฒนาโดย คณะแพทยศาสตร์โรงพยาบาลรามาธิบดี และการไฟฟ้าฝ่ายผลิตแห่งประเทศไทย (EGAT Study) ติดตามผลระยะยาวในประชากรไทย
                        </p>
                    </div>

                    <div>
                        <h4 data-i18n="riskThresholdsTitle">เกณฑ์การจัดกลุ่มความเสี่ยง 10 ปี</h4>
                        <ul style="font-size: 0.9rem; line-height: 1.8; padding-left: 1.2rem;">
                            <li><strong style="color: var(--risk-low);">&lt; 10% (เสี่ยงต่ำ):</strong> ปรับเปลี่ยนพฤติกรรมสุขภาพทั่วไป ตรวจสุขภาพซ้ำทุก 1-3 ปี</li>
                            <li><strong style="color: var(--risk-intermediate);">10% - 19.9% (เสี่ยงปานกลาง):</strong> ควบคุมอาหาร ออกกำลังกายสม่ำเสมอ พิจารณายาลดไขมันหากมีปัจจัยเสี่ยงอื่น</li>
                            <li><strong style="color: var(--risk-high);">20% - 29.9% (เสี่ยงสูง):</strong> ควรได้รับคำปรึกษาจากแพทย์ ปรับพฤติกรรมเข้มงวด และพิจารณาเริ่มยา Statin</li>
                            <li><strong style="color: var(--risk-veryhigh);">&ge; 30% (เสี่ยงสูงมาก):</strong> ความเสี่ยงอันตรายสูง ต้องพบแพทย์เพื่อตรวจคลื่นไฟฟ้าหัวใจและให้การรักษาทันที</li>
                        </ul>
                    </div>
                </div>

                <div class="data-caveat">
                    <strong data-i18n="caveatTitle">หมายเหตุสำคัญเกี่ยวกับข้อมูลบุหรี่:</strong>
                    <span data-i18n="caveatText">
                        ในการคำนวณเบื้องต้น ได้กำหนดให้ตัวแปรการสูบบุหรี่ = 0 (ไม่สูบ) สำหรับทุกคนตามข้อมูลตั้งต้นที่อยู่ระหว่างรอแบบสอบถามพฤติกรรม หากต้องการดูผลกระทบเมื่อมีการสูบบุหรี่ สามารถสลับโหมด "จำลองประชากร" หรือ "สมมติว่าสูบทุกคน" ได้ที่แถบตัวกรองด้านบน
                    </span>
                </div>
            </div>
        </div>

        <!-- Inline Data Injection & Interactive Dashboard Script -->
        <script is:inline define:vars={{ rawData: guardsData }}>
            window.DASHBOARD_DATA = rawData;
        </script>

        <script is:inline>
            // Translations Dictionary
            const I18N = {
                th: {
                    pageTitle: "แดชบอร์ดความเสี่ยงโรคหัวใจและหลอดเลือด (Thai CV Risk Score)",
                    pageSubtitle: "ระบบประเมินความเสี่ยงโรคหัวใจและหลอดเลือดในระยะเวลา 10 ปี (Thai CV Risk Score: Ramathibodi / EGAT) ของเจ้าหน้าที่รักษาความปลอดภัย ประจำปี 2569",
                    goToCalculator: "ประเมินความเสี่ยงด้วยตนเอง →",
