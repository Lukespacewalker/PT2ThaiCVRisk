                    highRiskLabel: "เสี่ยงสูง (20-29.9%)",
                    veryHighRiskLabel: "เสี่ยงสูงมาก (≥30%)"
                },
                en: {
                    pageTitle: "Cardiovascular Risk Dashboard (Thai CV Risk Score)",
