                    extrapolatedLabel: "Extrapolated",
                    respondentsUnit: "ผู้มีข้อมูล"
                },
                en: {
                    pageTitle: "Cardiovascular Risk Dashboard (Thai CV Risk Score)",
                    pageSubtitle: "10-Year Thai CV Risk Score (Ramathibodi / EGAT) with integrated smoking and alcohol lifestyle records for Security Personnel (2026)",
