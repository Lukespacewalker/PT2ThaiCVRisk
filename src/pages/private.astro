---
import "../styles/global.css";
import publicData from "../data/thai_cv_data.json";

// Safety check: On Cloudflare Pages (remote deployment), never expose private view
const isCloudflare = Boolean(process.env.CF_PAGES);
if (isCloudflare) {
    return Astro.redirect("/");
}

// Conditionally load private data if present locally on this machine
let guardsData = publicData;
try {
    const privateModule = await import("../data/thai_cv_data_private.json");
    if (privateModule && privateModule.default) {
        guardsData = privateModule.default;
    }
} catch (e) {
    // Fallback to public data
    guardsData = publicData;
}

const totalCount = guardsData.length;
---

<html lang="th" data-lang="th">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>[PRIVATE] Thai CV Risk Score Report - กองรักษาความปลอดภัย 2569 (แสดงรายชื่อ)</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Outfit:wght@500;700;800&display=swap"
            rel="stylesheet"
        />
        <script is:inline src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
        <style>
            .private-banner {
                background: #8E1B1B;
                color: #FFF;
                padding: 0.75rem 1.5rem;
                border-radius: 4px;
                border: 2px solid var(--border-color);
                box-shadow: 4px 4px 0px 0px var(--border-color);
                margin-bottom: 1.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-weight: 700;
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="private-banner">
                <span>🔒 รายงานฉบับภายใน (INTERNAL PRIVATE REPORT) - แสดงรายชื่อจริง 74 นาย</span>
                <a href="/" style="color: #FFF; text-decoration: underline; font-size: 0.9rem;">สลับไปฉบับ Public (ไม่แสดงชื่อ) →</a>
            </div>

            <!-- Header -->
            <header class="header" style="background-color: #8E1B1B;">
                <div class="header-controls">
                    <a href="/calculator" class="nav-button">
                        <span>ประเมินความเสี่ยงด้วยตนเอง →</span>
                    </a>
                    <div class="language-switcher" aria-label="Language selector">
                        <button class="language-button active" type="button" data-language="th">ไทย</button>
                        <button class="language-button" type="button" data-language="en">EN</button>
                    </div>
                </div>
                <h1>
                    แดชบอร์ดความเสี่ยงโรคหัวใจและหลอดเลือด [ฉบับแสดงรายชื่อ]
                </h1>
                <p class="header-subtitle">
                    รายงานผลการประเมินความเสี่ยงโรคหัวใจและหลอดเลือด 10 ปี (Thai CV Risk Score: Ramathibodi / EGAT) รายบุคคลของเจ้าหน้าที่รักษาความปลอดภัย ประจำปี 2569
                </p>
            </header>

            <!-- Filters Section -->
            <div class="filter-section">
                <div class="filter-row">
                    <!-- Mode Filter -->
                    <div class="filter-group">
                        <div class="filter-title">
                            โหมดข้อมูลการสูบบุหรี่
                        </div>
                        <div class="pill-list" id="mode-tabs">
                            <div class="pill active" data-mode="baseline">
                                ข้อมูลพื้นฐาน (ไม่สูบทุกคน)
                            </div>
                            <div class="pill" data-mode="simulated">
                                จำลองประชากร (ชายไทย ~35%)
                            </div>
                            <div class="pill" data-mode="smoke_all">
                                สมมติว่าสูบทุกคน (What-if)
                            </div>
                        </div>
                    </div>

                    <!-- Age Filter -->
                    <div class="filter-group">
                        <div class="filter-title">
                            ช่วงอายุ
                        </div>
                        <div class="pill-list" id="age-tabs">
                            <div class="pill active" data-age="ALL">ทั้งหมด</div>
                            <div class="pill" data-age="<40">&lt; 40 ปี</div>
                            <div class="pill" data-age="40-49">40 - 49 ปี</div>
                            <div class="pill" data-age="50-59">50 - 59 ปี</div>
                        </div>
                    </div>

                    <!-- Risk Category Filter -->
                    <div class="filter-group">
                        <div class="filter-title">
                            ระดับความเสี่ยง
                        </div>
                        <div class="pill-list" id="risk-tabs">
                            <div class="pill active" data-risk="ALL">ทั้งหมด</div>
                            <div class="pill" data-risk="Low Risk (<10%)">เสี่ยงต่ำ (&lt;10%)</div>
                            <div class="pill" data-risk="Intermediate Risk (10-19.9%)">เสี่ยงปานกลาง (10-19.9%)</div>
                            <div class="pill" data-risk="High Risk (20-29.9%)">เสี่ยงสูง (&ge;20%)</div>
                        </div>
                    </div>

                    <!-- BP Filter -->
                    <div class="filter-group">
                        <div class="filter-title">
                            ระดับความดันโลหิต
                        </div>
                        <div class="pill-list" id="bp-tabs">
                            <div class="pill active" data-bp="ALL">ทั้งหมด</div>
                            <div class="pill" data-bp="Normal BP">ความดันปกติ</div>
                            <div class="pill" data-bp="Prehypertension">เสี่ยงสูง (Pre-HTN)</div>
                            <div class="pill" data-bp="Stage 1 HTN">ความดันสูง ระดับ 1</div>
                            <div class="pill" data-bp="Stage 2 HTN">ความดันสูง ระดับ 2</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPIs Section -->
            <div class="grid">
                <!-- Total Assessed -->
                <div class="card">
                    <div class="card-title">
                        จำนวนเจ้าหน้าที่ที่ประเมิน
                    </div>
                    <div class="kpi-value" id="kpi-total">{totalCount}</div>
                    <div class="kpi-label">
                        เจ้าหน้าที่รักษาความปลอดภัย (เพศชาย 100%)
                    </div>
                    <div class="threshold-note">
                        ข้อมูลตรวจสุขภาพประจำปี 2569 ครบถ้วน 100%
                    </div>
                </div>

                <!-- Median Thai CV Risk -->
                <div class="card">
                    <div class="card-title">
                        มัธยฐานความเสี่ยง (Thai CV Risk)
                    </div>
                    <div class="kpi-value" id="kpi-median">0.0%</div>
                    <div class="kpi-label">
                        โอกาสเกิดโรคหัวใจและหลอดเลือดใน 10 ปี
                    </div>
                    <div class="threshold-note">
                        เกณฑ์มาตรฐาน: ต่ำ (&lt;10%), ปานกลาง (10-19%), สูง (&ge;20%)
                    </div>
                </div>

                <!-- High & Intermediate Risk Proportion -->
                <div class="card">
                    <div class="card-title">
                        สัดส่วนกลุ่มเสี่ยงปานกลาง-สูง
                    </div>
                    <div class="kpi-value" id="kpi-high-prop">0.0%</div>
                    <div class="kpi-label" id="kpi-high-count-label">
                        0 จาก 0 คน
                    </div>
                    <div class="threshold-note">
                        กลุ่มที่ควรได้รับการติดตามและปรับพฤติกรรมเร่งด่วน
                    </div>
                </div>

                <!-- Hypertension Prevalence -->
                <div class="card">
                    <div class="card-title">
                        ความดันโลหิตสูง (HTN)
                    </div>
                    <div class="kpi-value" id="kpi-htn-prop">0.0%</div>
                    <div class="kpi-label" id="kpi-htn-count-label">
                        SBP &ge; 140 หรือ DBP &ge; 90 mmHg
                    </div>
                    <div class="threshold-note">
                        ปัจจัยหลักที่มีน้ำหนักสูงในสมการ Thai CV Risk
                    </div>
                </div>

                <!-- Diabetes Prevalence -->
                <div class="card">
                    <div class="card-title">
                        เบาหวานและเสี่ยงเบาหวาน
                    </div>
                    <div class="kpi-value" id="kpi-dm-prop">0.0%</div>
                    <div class="kpi-label" id="kpi-dm-count-label">
                        FBS &ge; 100 mg/dL (เบาหวาน &ge; 126)
                    </div>
                    <div class="threshold-note">
                        ภาวะเบาหวานเพิ่มแต้มความเสี่ยงในสมการ +0.70
                    </div>
                </div>
            </div>

            <!-- Charts Row 1: Distribution & Scatter -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(480px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                <div class="card" style="margin-bottom: 0;">
                    <div class="card-title">
                        สัดส่วนระดับความเสี่ยง (Thai CV Risk Stratification)
                    </div>
                    <div class="chart-container" id="riskDistChart" style="height: 420px;"></div>
                </div>

                <div class="card" style="margin-bottom: 0;">
                    <div class="card-title">
                        ความสัมพันธ์ระหว่างอายุ ความดันโลหิต และคะแนนความเสี่ยง
                    </div>
                    <div class="chart-container" id="scatterChart" style="height: 420px;"></div>
                </div>
            </div>

            <!-- Detailed Table Section (With Real Names) -->
            <div class="card">
                <div class="card-title">
                    <span>รายชื่อพนักงานและผลการประเมินรายบุคคล (แสดงชื่อจริง)</span>
                    <input
                        type="text"
                        id="search-input"
                        class="search-input"
                        placeholder="ค้นหาชื่อหรือลำดับ..."
                    />
                </div>
                <div class="table-wrap">
                    <table class="data-table" id="guards-table">
                        <thead>
                            <tr>
                                <th data-sort="id">ลำดับ ⇅</th>
                                <th data-sort="name">ชื่อ-สกุล (จริง) ⇅</th>
                                <th data-sort="age">อายุ ⇅</th>
                                <th data-sort="sbp">ความดัน (SBP/DBP) ⇅</th>
                                <th data-sort="bmi">BMI ⇅</th>
                                <th data-sort="fbs">น้ำตาล FBS ⇅</th>
                                <th data-sort="cholesterol">โคเลสเตอรอลรวม ⇅</th>
                                <th data-sort="hdl">HDL-C ⇅</th>
                                <th data-sort="ldl">LDL-C ⇅</th>
                                <th data-sort="thai_cv_risk">Thai CV Risk (%) ⇅</th>
                                <th data-sort="risk_category">ระดับความเสี่ยง ⇅</th>
                            </tr>
                        </thead>
                        <tbody id="table-body">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <script is:inline define:vars={{ rawData: guardsData }}>
            window.DASHBOARD_DATA = rawData;
        </script>

        <script is:inline>
            let currentMode = "baseline";
            let selectedAge = "ALL";
            let selectedRisk = "ALL";
            let selectedBP = "ALL";
            let searchQuery = "";
            let sortColumn = "id";
            let sortAsc = true;

            function getEffectiveRisk(row, mode) {
                if (mode === "simulated") return row.thai_cv_risk_sim_med ?? row.thai_cv_risk;
                if (mode === "smoke_all") return row.thai_cv_risk_if_smoke ?? row.thai_cv_risk;
                return row.thai_cv_risk;
            }

            function getEffectiveCategory(risk) {
                if (risk === null || risk === undefined) return "Unknown";
                if (risk < 10.0) return "Low Risk (<10%)";
                if (risk < 20.0) return "Intermediate Risk (10-19.9%)";
                if (risk < 30.0) return "High Risk (20-29.9%)";
                return "Very High Risk (>=30%)";
            }

            function filterData() {
                return window.DASHBOARD_DATA.filter(row => {
                    const effRisk = getEffectiveRisk(row, currentMode);
                    if (selectedAge !== "ALL" && row.age_group !== selectedAge) return false;
                    if (selectedRisk !== "ALL") {
                        if (selectedRisk === "Low Risk (<10%)" && effRisk >= 10.0) return false;
                        if (selectedRisk === "Intermediate Risk (10-19.9%)" && (effRisk < 10.0 || effRisk >= 20.0)) return false;
                        if (selectedRisk === "High Risk (20-29.9%)" && effRisk < 20.0) return false;
                    }
                    if (selectedBP !== "ALL" && row.bp_stage !== selectedBP) return false;
                    if (searchQuery) {
                        const q = searchQuery.toLowerCase();
                        if (!row.name.toLowerCase().includes(q) && !String(row.id).includes(q)) return false;
                    }
                    return true;
                });
            }

            function updateKPIs(filtered) {
                const total = filtered.length;
                document.getElementById("kpi-total").innerText = total;

                if (total === 0) {
                    document.getElementById("kpi-median").innerText = "0.0%";
                    document.getElementById("kpi-high-prop").innerText = "0.0%";
                    document.getElementById("kpi-high-count-label").innerText = "0 / 0";
                    document.getElementById("kpi-htn-prop").innerText = "0.0%";
                    document.getElementById("kpi-htn-count-label").innerText = "0 / 0";
                    document.getElementById("kpi-dm-prop").innerText = "0.0%";
                    document.getElementById("kpi-dm-count-label").innerText = "0 / 0";
                    return;
                }

                const risks = filtered.map(r => getEffectiveRisk(r, currentMode)).sort((a, b) => a - b);
                const median = risks.length % 2 === 0
                    ? ((risks[risks.length / 2 - 1] + risks[risks.length / 2]) / 2).toFixed(2)
                    : risks[Math.floor(risks.length / 2)].toFixed(2);
                document.getElementById("kpi-median").innerText = `${median}%`;

                const highRiskCount = filtered.filter(r => getEffectiveRisk(r, currentMode) >= 10.0).length;
                const highRiskProp = ((highRiskCount / total) * 100).toFixed(1);
                document.getElementById("kpi-high-prop").innerText = `${highRiskProp}%`;
                document.getElementById("kpi-high-count-label").innerText = `${highRiskCount} / ${total} คน`;

                const htnCount = filtered.filter(r => (r.sbp >= 140 || r.dbp >= 90)).length;
                const htnProp = ((htnCount / total) * 100).toFixed(1);
                document.getElementById("kpi-htn-prop").innerText = `${htnProp}%`;
                document.getElementById("kpi-htn-count-label").innerText = `${htnCount} / ${total} คน`;

                const dmCount = filtered.filter(r => r.fbs >= 100).length;
                const dmProp = ((dmCount / total) * 100).toFixed(1);
                const actualDmCount = filtered.filter(r => r.fbs >= 126).length;
                document.getElementById("kpi-dm-prop").innerText = `${dmProp}%`;
                document.getElementById("kpi-dm-count-label").innerText = `เบาหวาน ${actualDmCount} คน, เสี่ยง ${dmCount - actualDmCount} คน`;
            }

            function renderCharts(filtered) {
                const total = filtered.length;
                const catCounts = {
                    "Low Risk (<10%)": 0,
                    "Intermediate Risk (10-19.9%)": 0,
                    "High Risk (20-29.9%)": 0,
                    "Very High Risk (>=30%)": 0
                };
                filtered.forEach(r => {
                    const cat = getEffectiveCategory(getEffectiveRisk(r, currentMode));
                    if (catCounts[cat] !== undefined) catCounts[cat]++;
                });

                const catLabels = ["เสี่ยงต่ำ (<10%)", "เสี่ยงปานกลาง (10-19.9%)", "เสี่ยงสูง (20-29.9%)", "เสี่ยงสูงมาก (≥30%)"];
                const catValues = [
                    catCounts["Low Risk (<10%)"],
                    catCounts["Intermediate Risk (10-19.9%)"],
                    catCounts["High Risk (20-29.9%)"],
                    catCounts["Very High Risk (>=30%)"]
                ];

                Plotly.react('riskDistChart', [{
                    x: catLabels,
                    y: catValues,
                    type: 'bar',
                    marker: { color: ["#2E7D32", "#E6A23C", "#E65100", "#C62828"], line: { color: '#2A2A2A', width: 2 } },
                    text: catValues.map(v => total > 0 ? `${v} (${((v/total)*100).toFixed(1)}%)` : "0"),
                    textposition: 'auto'
                }], {
                    font: { family: 'Outfit, Inter, sans-serif' },
                    paper_bgcolor: 'transparent',
                    plot_bgcolor: 'transparent',
                    margin: { t: 30, r: 20, l: 40, b: 60 }
                }, { responsive: true, displayModeBar: false });

                Plotly.react('scatterChart', [{
                    x: filtered.map(r => r.age),
                    y: filtered.map(r => r.sbp),
                    text: filtered.map(r => `${r.name}<br>อายุ: ${r.age} ปี<br>SBP: ${r.sbp} mmHg<br>Risk: ${getEffectiveRisk(r, currentMode)}%`),
                    mode: 'markers',
                    type: 'scatter',
                    marker: {
                        size: filtered.map(r => Math.max(10, Math.min(26, getEffectiveRisk(r, currentMode) * 1.2))),
                        color: filtered.map(r => getEffectiveRisk(r, currentMode)),
                        colorscale: [[0.0, '#2E7D32'], [0.35, '#E6A23C'], [0.7, '#E65100'], [1.0, '#C62828']],
                        showscale: true,
                        line: { color: '#2A2A2A', width: 1.5 }
                    }
                }], {
                    font: { family: 'Outfit, Inter, sans-serif' },
                    paper_bgcolor: 'transparent',
                    plot_bgcolor: 'transparent',
                    margin: { t: 30, r: 20, l: 50, b: 50 },
                    xaxis: { title: 'อายุ (ปี)' },
                    yaxis: { title: 'SBP (mmHg)' }
                }, { responsive: true, displayModeBar: false });
            }

            function renderTable(filtered) {
                const tbody = document.getElementById("table-body");
                if (!tbody) return;

                const sorted = [...filtered].sort((a, b) => {
                    let valA = a[sortColumn];
                    let valB = b[sortColumn];
                    if (sortColumn === "thai_cv_risk") {
                        valA = getEffectiveRisk(a, currentMode);
                        valB = getEffectiveRisk(b, currentMode);
                    }
                    if (valA === null) return 1;
                    if (valB === null) return -1;
                    if (valA < valB) return sortAsc ? -1 : 1;
                    if (valA > valB) return sortAsc ? 1 : -1;
                    return 0;
                });

                tbody.innerHTML = sorted.map(row => {
                    const risk = getEffectiveRisk(row, currentMode);
                    let badgeClass = "badge-low";
                    let catLabel = "เสี่ยงต่ำ (<10%)";

                    if (risk >= 30.0) {
                        badgeClass = "badge-veryhigh";
                        catLabel = "เสี่ยงสูงมาก (≥30%)";
                    } else if (risk >= 20.0) {
                        badgeClass = "badge-high";
                        catLabel = "เสี่ยงสูง (20-29.9%)";
                    } else if (risk >= 10.0) {
                        badgeClass = "badge-intermediate";
                        catLabel = "เสี่ยงปานกลาง (10-19.9%)";
                    }

                    return `
                        <tr>
                            <td><strong>${row.id}</strong></td>
                            <td><strong style="color:var(--primary); font-size:1.02rem;">${row.name}</strong></td>
                            <td>${row.age}</td>
                            <td>${row.sbp} / ${row.dbp} <span style="font-size:0.78rem; color:#666;">(${row.bp_stage})</span></td>
                            <td>${row.bmi ? row.bmi.toFixed(1) : '-'}</td>
                            <td>${row.fbs} ${row.fbs >= 126 ? '<span style="color:#B71C1C; font-weight:bold;">(DM)</span>' : ''}</td>
                            <td>${row.cholesterol}</td>
                            <td>${row.hdl}</td>
                            <td>${row.ldl}</td>
                            <td><strong style="font-size:1.05rem; color:var(--accent);">${risk !== null ? risk.toFixed(2) + '%' : '-'}</strong></td>
                            <td><span class="badge ${badgeClass}">${catLabel}</span></td>
                        </tr>
                    `;
                }).join("");
            }

            function refresh() {
                const filtered = filterData();
                updateKPIs(filtered);
                renderCharts(filtered);
                renderTable(filtered);
            }

            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll("#mode-tabs .pill").forEach(p => {
                    p.addEventListener("click", () => {
                        document.querySelectorAll("#mode-tabs .pill").forEach(x => x.classList.remove("active"));
                        p.classList.add("active");
                        currentMode = p.getAttribute("data-mode");
                        refresh();
                    });
                });
                document.querySelectorAll("#age-tabs .pill").forEach(p => {
                    p.addEventListener("click", () => {
                        document.querySelectorAll("#age-tabs .pill").forEach(x => x.classList.remove("active"));
                        p.classList.add("active");
                        selectedAge = p.getAttribute("data-age");
                        refresh();
                    });
                });
                document.querySelectorAll("#risk-tabs .pill").forEach(p => {
                    p.addEventListener("click", () => {
                        document.querySelectorAll("#risk-tabs .pill").forEach(x => x.classList.remove("active"));
                        p.classList.add("active");
                        selectedRisk = p.getAttribute("data-risk");
                        refresh();
                    });
                });
                document.querySelectorAll("#bp-tabs .pill").forEach(p => {
                    p.addEventListener("click", () => {
                        document.querySelectorAll("#bp-tabs .pill").forEach(x => x.classList.remove("active"));
                        p.classList.add("active");
                        selectedBP = p.getAttribute("data-bp");
                        refresh();
                    });
                });

                document.getElementById("search-input").addEventListener("input", e => {
                    searchQuery = e.target.value.trim();
                    refresh();
                });

                document.querySelectorAll("#guards-table th[data-sort]").forEach(th => {
                    th.addEventListener("click", () => {
                        const col = th.getAttribute("data-sort");
                        if (sortColumn === col) sortAsc = !sortAsc;
                        else { sortColumn = col; sortAsc = true; }
                        refresh();
                    });
                });

                refresh();
            });
        </script>
    </body>
</html>
